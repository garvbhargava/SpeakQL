# The Dockerfile does `COPY . .`. Without this file that copies .env -- every
# role password and the JWT signing key -- into an image layer, where it stays
# even if a later layer deletes it. Compose passes .env at runtime instead.
.env
.env.*
!.env.example

# Training data and checkpoints are hundreds of megabytes and are NOT baked in:
# compose mounts ml/checkpoints read-only, so retraining does not mean
# rebuilding the image.
ml/data/
ml/checkpoints/
ml/results/*.log

.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.git/
*.log
