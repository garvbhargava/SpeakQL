# SpeakQL backend · copy to .env and fill in. .env is gitignored and must stay
# that way -- Backend Plan §18.
#
# config.py validates all of this at startup and exits if something required is
# missing, so a typo here is a clear message rather than a failure inside a
# request three screens later.

SPEAKQL_ENV=development

# Sign JWTs with this. Generate one: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-you-commit-anything

# --- the five runtime DSNs (§5.1) -------------------------------------------
# One per role. The API loads exactly these and can construct no others, and
# config.py REFUSES TO START if any of them names speakql_owner or postgres.
# For the three warehouse roles only the credentials matter: the database name
# is swapped per connection by db/tenant_engine.py.
# (Under docker compose these are overridden with host `db`; the values here
# are for running the API directly on your machine.)
META_DSN=postgresql+psycopg://speakql_app:app_dev@localhost:5432/speakql_meta
RO_DSN=postgresql+psycopg://speakql_ro:ro_dev@localhost:5432/northwind_dw
WRITE_DSN=postgresql+psycopg://speakql_write:write_dev@localhost:5432/northwind_dw
EDITS_DSN=postgresql+psycopg://speakql_edits_rw:edits_dev@localhost:5432/northwind_dw
UPLOADS_DSN=postgresql+psycopg://speakql_upload_ddl:upload_dev@localhost:5432/speakql_uploads

# --- NOT loaded by the API --------------------------------------------------
# speakql_owner is a superuser. It is used by bootstrap.sh alone, which under
# compose runs in its own one-off container; the api container is never given
# this value. config.py defines no field for it.
SPEAKQL_OWNER_DSN=postgresql://speakql_owner:speakql_dev_owner@localhost:5432/postgres

# role passwords, used by bootstrap.sh when it creates the roles
POSTGRES_PASSWORD=speakql_dev_owner
APP_PASSWORD=app_dev
RO_PASSWORD=ro_dev
WRITE_PASSWORD=write_dev
EDITS_PASSWORD=edits_dev
UPLOAD_PASSWORD=upload_dev

# --- models -----------------------------------------------------------------
LLM_MODE=local
LLM_MODEL=gemma3:4b
LLM_ENDPOINT=http://localhost:11434
CONFIDENCE_THRESHOLD=0.55

# --- policy -----------------------------------------------------------------
# personal_workspace | invite_only | blocked  (§7.2)
FREE_EMAIL_MODE=personal_workspace
STATEMENT_TIMEOUT_MS=10000
MAX_ROWS=5000

# --- rate limits (§7.4) -----------------------------------------------------
RATE_ASK_PER_HOUR=60
RATE_UPLOAD_PER_DAY=20
RATE_EXPORT_PER_HOUR=30
