# Which transport the app talks to. `mock` needs no backend at all; `live`
# calls the API. Switching between them is this one line — that is the whole
# point of routing every screen through api.something() (Spec §24).
VITE_TRANSPORT=live

# Where the API lives. Empty means same-origin, which is what the Vite dev
# proxy and the Full-Stack compose file both arrange. Set it only when the API
# is somewhere else.
VITE_API_BASE=

# Where the dev proxy forwards /api and /health. Used by vite.config.js only.
VITE_API_TARGET=http://localhost:8000
